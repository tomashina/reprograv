<div id="mobile-navigation" class="main-menu-wrapper hidden-md hidden-lg" role="dialog" aria-modal="true" aria-label="Glavna navigacija" aria-hidden="true">
    <div class="mobile-nav-header">
        <div class="mobile-nav-heading">
            <span class="mobile-nav-mark" aria-hidden="true"></span>
            <span class="mobile-nav-title">Izbornik</span>
        </div>
        <a href="#mobile-navigation" class="mobile-nav-close menu-closer hidden-md hidden-lg" title="Zatvori izbornik" aria-label="Zatvori izbornik">
            <i class="icon-line-cross icon" aria-hidden="true"></i>
        </a>
    </div>

    <div class="mobile-nav-scroll">
        <p class="mobile-nav-section-title">Navigacija</p>
{% if primary_menu %}
<ul class="categories mobile-nav-list">
{% if primary_menu == 'oc' %}
<!-- Default menu -->
{{ default_menu }}
{% elseif primary_menu is defined %}
<!-- Mega menu -->
{% for key, row in primary_menu_mobile %}
{% include 'basel/template/common/menus/mega_menu.twig' %}
{% endfor %}
{% endif %}
</ul>
{% endif %}

{% if secondary_menu %}
<p class="mobile-nav-section-title mobile-nav-shop-title">Web narudžba</p>
<ul class="categories mobile-nav-list mobile-nav-shop">
    {% if secondary_menu == 'oc' %}
        <!-- Default menu -->
        {{ default_menu }}
    {% elseif secondary_menu is defined %}
        <!-- Mega menu -->
        {% for key, row in secondary_menu_mobile %}
            {% include 'basel/template/common/menus/mega_menu.twig' %}
        {% endfor %}
    {% endif %}
</ul>
{% endif %}

    </div>
</div>
<span class="body-cover menu-closer" aria-hidden="true"></span>
