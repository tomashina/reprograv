<div class="container">
    {{ position_bottom_half }}
</div>
<div class="container">
    {{ position_bottom }}
</div>
<div id="footer">

    <div class="logo-footer"><img src="image/footer-logo.svg" alt="Repro-Grav" width="100" height="100" loading="lazy"></div>
    <div class="container">
        {% if footer_block_1 and footer_block_1 != '<p><br></p>' %}
            <div class="footer-top-block">
                {{ footer_block_1 }}
            </div>
        {% endif %}
        <div class="row links-holder">
            <div class="col-xs-12 col-sm-12">
                <div class="row">
                    {% if custom_links %}
                        {% for column in basel_footer_columns %}
                            {% set is_first_footer_column = loop.first %}
                            <div class="footer-column col-xs-12 col-sm-3 eq_height">
                                {% if column.title %}
                                    <p class="h5">
                                        <a  role="button" data-toggle="collapse" href="#collapse{{ column.sort }}9" aria-expanded="false" aria-controls="collapse{{ column.sort }}9">
                                            {{ column.title }}  <b class="pull-right visible-xs">+</b>
                                        </a>
                                    </p>
                                {% endif %}

                                <div class="collapse in" id="collapse{{ column.sort }}9">
                                    {% if column.links is defined %}
                                        <ul class="list-unstyled">
                                            {% for link in column.links %}
                                                <li><a href="{{ link.target }}">{{ link.title }}</a></li>
                                            {% endfor %}
                                            {% if is_first_footer_column %}
                                                <li><a href="{{ contract_withdrawal }}">{{ text_contract_withdrawal }}</a></li>
                                                <li><a href="#cookie-settings" data-cookie-consent-trigger>{{ text_cookie_settings }}</a></li>
                                            {% endif %}
                                        </ul>
                                    {% endif %}

                                </div>

                                <script>
                                    $(document).ready(function(){
                                        if ($(window).width() <= 768) {
                                            $("#collapse19").removeClass("in");
                                            $("#collapse29").removeClass("in");
                                            $("#collapse39").removeClass("in");
                                        }
                                    });
                                </script>



                            </div>
                        {% endfor %}
                    {% else %}
                        {% if informations %}
                            <div class="footer-column col-xs-6 col-sm-3 eq_height">
                                <h5>{{ text_information }}</h5>
                                <ul class="list-unstyled">
                                    {% for information in informations %}
                                        <li><a href="{{ information.href }}">{{ information.title }}</a></li>
                                    {% endfor %}
                                    <li><a href="{{ contract_withdrawal }}">{{ text_contract_withdrawal }}</a></li>
                                    <li><a href="#cookie-settings" data-cookie-consent-trigger>{{ text_cookie_settings }}</a></li>
                                    <li><a href="{{ contact }}">{{ text_contact }}</a></li>
                                </ul>
                            </div>
                        {% endif %}
                        <div class="footer-column col-xs-6 col-sm-3 eq_height">
                            <h5>{{ text_extra }}</h5>
                            <ul class="list-unstyled">
                                <li><a href="{{ manufacturer }}">{{ text_manufacturer }}</a></li>
                                <li><a href="{{ voucher }}">{{ text_voucher }}</a></li>
                                <li><a href="{{ affiliate }}">{{ text_affiliate }}</a></li>
                                <li><a href="{{ special }}">{{ text_special }}</a></li>
                                <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
                            </ul>
                        </div>
                        <div class="footer-column col-xs-6 col-sm-3 eq_height">
                            <h5>{{ text_account }}</h5>
                            <ul class="list-unstyled">
                                <li><a href="{{ account }}">{{ text_account }}</a></li>
                                <li><a href="{{ order }}">{{ text_order }}</a></li>
                                <li><a href="{{ return }}">{{ text_return }}</a></li>
                                <li class="is_wishlist"><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
                                <li><a href="{{ newsletter }}">{{ text_newsletter }}</a></li>
                            </ul>
                        </div>
                    {% endif %}
                    <div class="footer-column col-xs-12 col-sm-3 eq_height">
                       
                        <div class="footer-custom-wrapper">
                            {% if footer_block_title is defined %}
                                <p class="h5">{{ footer_block_title }}</p>
                            {% endif %}
                            {% if footer_block_2 and footer_block_2 != '<p><br></p>' %}
                                <div class="custom_block">{{ footer_block_2 }}</div>
                            {% endif %}
                            {% if footer_infoline_1 is defined %}
                                <p class="infoline">{{ footer_infoline_1 }}</p>
                            {% endif %}
                            {% if footer_infoline_2 is defined %}
                                <p class="infoline">{{ footer_infoline_2 }}</p>
                            {% endif %}
                            {% if footer_infoline_3 is defined %}
                                <p class="infoline">{{ footer_infoline_3 }}</p>
                            {% endif %}
                            {% if payment_img %}
                                <img class="payment_img" src="{{ payment_img }}" alt="" />
                            {% endif %}
                        </div>
                    </div>
                </div><!-- .row ends -->
            </div><!-- .col-md-8 ends -->

            <div class="col-xs-12 text-center cards-holder" >
               <!-- <p class="infoline"><a href="#" aria-label="Follow us on Facebook"><i class="fa fa-2x fa-facebook-square"></i> </a></p>-->
                <p class="infoline"><a href="https://www.instagram.com/reprograv.hr/" aria-label="Pratite Repro-Grav na Instagramu"><i class="fa fa-2x fa-instagram"></i> </a> </p>
                <!--<p class="infoline">
                    <a href="#" aria-label="Follow us on Linkedin"><i class="fa fa-2x fa-linkedin"></i> </a></p> -->
            </div>
            <div class="clearfix"></div>

        </div><!-- .row ends -->




    </div>
    <div class="continer-fluid">
        {% if basel_copyright %}
            <div class="footer-copyright">{{ basel_copyright }}</div>
        {% endif %}
    </div>

</div>


<link rel="preload" as="style" href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" onload="this.onload=null;this.rel='stylesheet'" />
<style>
@font-face {
    font-family: "FontAwesome";
    src: url("catalog/view/javascript/font-awesome/fonts/fontawesome-webfont.woff2?v=4.7.0") format("woff2"),
         url("catalog/view/javascript/font-awesome/fonts/fontawesome-webfont.woff?v=4.7.0") format("woff");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}
</style>
<link rel="preload" as="style" href="catalog/view/theme/basel/js/lightgallery/css/lightgallery.css" onload="this.onload=null;this.rel='stylesheet'" />
<noscript>
<link href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
<link href="catalog/view/theme/basel/js/lightgallery/css/lightgallery.css" rel="stylesheet" />
</noscript>
<script defer src="catalog/view/theme/basel/js/jquery.matchHeight.min.js"></script>
<script defer src="catalog/view/theme/basel/js/countdown.js"></script>
<script defer src="catalog/view/theme/basel/js/featherlight.js"></script>
{% if view_popup %}
    <!-- Popup -->
    <script>
        $(document).ready(function() {
            if ($(window).width() > {{ popup_width_limit }}) {
                setTimeout(function() {
                    $.featherlight({ajax: 'index.php?route=extension/basel/basel_features/basel_popup', variant:'popup-wrapper'});
                }, {{ popup_delay }});
            }
        });
    </script>
{% endif %}
{% if sticky_columns %}
    <!-- Sticky columns -->
    <script>
    $(function() {
        if ($(window).width() > 767) {
            $('#column-left, #column-right').theiaStickySidebar({containerSelector:$(this).closest('.row'),additionalMarginTop:{{ sticky_columns_offset }}});
        }
    });
    </script>
{% endif %}

</div><!-- .outer-container ends -->
<a class="scroll-to-top email primary-bg-color hidden-xs" href="mailto:repro@repro-grav.hr"><img src="image/envelope.svg" class="ikona" alt="Pošaljite email" width="20" height="16"></a>
<button type="button" class="scroll-to-top top primary-bg-color hidden-xs" onclick="$('html, body').animate({scrollTop:0});" aria-label="Na vrh"><img src="image/up.svg" class="ikona" alt="" width="18" height="10"></button>
<button type="button" class="rg-cookie-fab" data-cookie-consent-trigger aria-label="{{ text_cookie_settings }}" title="{{ text_cookie_settings }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5Z"/><path d="M8.5 8.5h.01M16 15.5h.01M12 12h.01M11 17h.01M7 14h.01"/></svg></button>
<div id="featherlight-holder"></div>
<script defer src="catalog/view/javascript/cookieconsent/reprograv-consent.js?v=20260730.3"></script>
<script>
$(function() {
    var improveGeneratedAccessibility = function() {
        $('.tt-hint').attr({'aria-hidden': 'true', 'tabindex': '-1'});
        $('.cc-link, .cc-btn').each(function() {
            var visibleLabel = $.trim($(this).text());
            if (visibleLabel && $(this).attr('aria-label') !== visibleLabel) {
                $(this).attr('aria-label', visibleLabel);
            }
        });
    };

    improveGeneratedAccessibility();
    setTimeout(improveGeneratedAccessibility, 0);

    if ('MutationObserver' in window) {
        new MutationObserver(improveGeneratedAccessibility).observe(document.body, {
            childList: true,
            subtree: true
        });
    }
});
</script>
</body></html>
