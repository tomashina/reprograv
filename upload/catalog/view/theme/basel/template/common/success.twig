{{ header }}
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1 id="page-title">{{ heading_title }}</h1>
      <div class="success-page-card">
        <span class="success-page-icon" aria-hidden="true"><i class="fa fa-check"></i></span>
        <div class="success-page-copy">{{ text_message }}</div>
        {% if scan %}
        <div class="success-page-scan"><img src="{{ scan }}" alt="" /></div>
        {% endif %}
        {% if continue and button_continue %}
        <div class="success-page-actions">
          <a href="{{ continue }}" class="btn btn-primary">{{ button_continue }} <i class="fa fa-angle-right" aria-hidden="true"></i></a>
        </div>
        {% endif %}
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
