{{ header }}
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if success %}
  <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }} account-dashboard">{{ content_top }}
    <h1 id="page-title">{{ text_my_account }}</h1>
      <section class="account-dashboard-section">
        <legend>{{ text_my_account }}</legend>
        <ul class="list-unstyled account-dashboard-grid">
          <li><a href="{{ edit }}"><i class="fa fa-user" aria-hidden="true"></i><span>{{ text_edit }}</span></a></li>
          <li><a href="{{ password }}"><i class="fa fa-lock" aria-hidden="true"></i><span>{{ text_password }}</span></a></li>
          <li><a href="{{ address }}"><i class="fa fa-map-marker" aria-hidden="true"></i><span>{{ text_address }}</span></a></li>
          <li><a href="{{ wishlist }}"><i class="fa fa-heart-o" aria-hidden="true"></i><span>{{ text_wishlist }}</span></a></li>
        </ul>
      </section>
      {% if credit_cards %}
      <section class="account-dashboard-section">
        <legend>{{ text_credit_card }}</legend>
        <ul class="list-unstyled account-dashboard-grid">
          {% for credit_card in credit_cards %}
          <li><a href="{{ credit_card.href }}"><i class="fa fa-credit-card" aria-hidden="true"></i><span>{{ credit_card.name }}</span></a></li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
      <section class="account-dashboard-section">
        <legend>{{ text_my_orders }}</legend>
        <ul class="list-unstyled account-dashboard-grid">
          <li><a href="{{ order }}"><i class="fa fa-file-text-o" aria-hidden="true"></i><span>{{ text_order }}</span></a></li>
        </ul>
      </section>

      <section class="account-dashboard-section">
        <legend>{{ text_my_newsletter }}</legend>
        <ul class="list-unstyled account-dashboard-grid">
          <li><a href="{{ newsletter }}"><i class="fa fa-envelope-o" aria-hidden="true"></i><span>{{ text_newsletter }}</span></a></li>
        </ul>
      </section>

      <section class="account-dashboard-section account-dashboard-section-muted">
        <legend>{{ text_logout }}</legend>
        <ul class="list-unstyled account-dashboard-grid">
          <li><a href="{{ logout }}"><i class="fa fa-sign-out" aria-hidden="true"></i><span>{{ text_logout }}</span></a></li>
        </ul>
      </section>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
