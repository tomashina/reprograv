{{ header }}

{% if basel_map_lat and basel_map_lon and basel_map_style == "full_width" %}
<div id="gmap" class="map-full-width">
  <div class="address-holder col-sm-5 col-md-4 col-lg-3">
    <h2 class="contrast-heading">{{ store }}</h2>
    <p>{{ address }}</p>
    <a class="uline_link to_form" href="#contact-form">{{ text_contact }}</a>
  </div>
</div>
{% endif %}

<div class="container contact-page">
  <nav aria-label="Putanja stranice">
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}
          <li><span aria-current="page">{{ breadcrumb.text }}</span></li>
        {% else %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>

  <div class="row">
    {{ column_left }}

    {% if basel_map_lat and basel_map_lon and basel_map_style == "inline" %}
      <div id="gmap" class="col-sm-12 map-inline"></div>
    {% endif %}

    {% if column_left and column_right %}
      {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
      {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">
      {{ content_top }}

      <header class="contact-page-intro">
        <span class="page-eyebrow">Repro-Grav podrška</span>
        <h1 id="page-title">{{ heading_title }}</h1>
        <p>Pošaljite nam upit ili nas nazovite. Rado ćemo pomoći pri odabiru stroja, materijala, pečata i pribora.</p>
      </header>

      <div class="contact-page-grid">
        <section class="contact-form-card" id="contact-form" aria-labelledby="contact-form-title">
          <div class="contact-section-heading">
            <span class="contact-section-icon icon-envelope" aria-hidden="true"></span>
            <div>
              <span class="contact-section-kicker">Javite nam se</span>
              <h2 id="contact-form-title">{{ text_contact }}</h2>
            </div>
          </div>

          <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-vertical contact-form">
            <div class="row">
              <div class="form-group col-sm-12 required">
                <label for="input-name">{{ entry_name }}</label>
                <input
                  type="text"
                  name="name"
                  value="{{ name }}"
                  id="input-name"
                  class="form-control"
                  autocomplete="name"
                  required
                  {% if error_name %}aria-invalid="true" aria-describedby="error-name"{% endif %}
                />
                {% if error_name %}
                  <div class="text-danger" id="error-name">{{ error_name }}</div>
                {% endif %}
              </div>

              <div class="form-group col-sm-12 required">
                <label for="input-email">{{ entry_email }}</label>
                <input
                  type="email"
                  name="email"
                  value="{{ email }}"
                  id="input-email"
                  class="form-control"
                  autocomplete="email"
                  required
                  {% if error_email %}aria-invalid="true" aria-describedby="error-email"{% endif %}
                />
                {% if error_email %}
                  <div class="text-danger" id="error-email">{{ error_email }}</div>
                {% endif %}
              </div>

              <div class="form-group col-sm-12">
                <label for="input-telefon">Telefon</label>
                <input
                  type="tel"
                  name="telefon"
                  value="{{ telefon }}"
                  id="input-telefon"
                  class="form-control"
                  autocomplete="tel"
                />
              </div>
            </div>

            <div class="form-group required">
              <label for="input-enquiry">{{ entry_enquiry }}</label>
              <textarea
                name="enquiry"
                rows="6"
                id="input-enquiry"
                class="form-control"
                required
                {% if error_enquiry %}aria-invalid="true" aria-describedby="error-enquiry"{% endif %}
              >{{ test }}{{ test and enquiry ? ' ' : '' }}{{ enquiry }}</textarea>
              {% if error_enquiry %}
                <div class="text-danger" id="error-enquiry">{{ error_enquiry }}</div>
              {% endif %}
            </div>

            {{ captcha }}

            <div class="contact-form-footer">
              <span class="contact-required-note"><span aria-hidden="true">*</span> Obavezna polja</span>
              <button class="btn btn-primary contact-submit" type="submit">
                {{ button_submit }}
                <i class="fa fa-angle-right" aria-hidden="true"></i>
              </button>
            </div>
          </form>
        </section>

        <aside class="contact-details-card" aria-labelledby="contact-details-title">
          <div class="contact-section-heading">
            <span class="contact-section-icon icon-location-pin" aria-hidden="true"></span>
            <div>
              <span class="contact-section-kicker">Kontakt podaci</span>
              <h2 id="contact-details-title">{{ store }}</h2>
            </div>
          </div>

          {% if image %}
            <div class="contact-image">
              <img src="{{ image }}" alt="{{ store }}" title="{{ store }}" />
            </div>
          {% endif %}

          <div class="contact-detail-list">
            <div class="contact-detail-row">
              <span class="contact-detail-icon icon-location-pin" aria-hidden="true"></span>
              <div>
                <h3>Adresa</h3>
                <div class="contact-detail-copy">
                  {{ address }}<br />
                  E-mail: <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
                </div>
              </div>
            </div>

            <div class="contact-detail-row">
              <span class="contact-detail-icon icon-phone" aria-hidden="true"></span>
              <div>
                <h3>Telefon</h3>
                <p><a href="tel:{{ telephone|replace({' ': '', '/': '', '(': '', ')': ''}) }}">{{ telephone }}</a></p>
                {% if fax %}
                  <p><a href="tel:{{ fax|replace({' ': '', '/': '', '(': '', ')': ''}) }}">{{ fax }}</a></p>
                {% endif %}
              </div>
            </div>

            {% if open %}
              <div class="contact-detail-row">
                <span class="contact-detail-icon icon-clock" aria-hidden="true"></span>
                <div>
                  <h3>{{ text_open }}</h3>
                  <div class="contact-detail-copy">{{ open }}</div>
                </div>
              </div>
            {% endif %}
          </div>

          {% if comment %}
            <div class="contact-company-info">
              <h3>{{ text_comment }}</h3>
              <div>{{ comment }}</div>
            </div>
          {% endif %}
        </aside>
      </div>

      {% if locations %}
        <section class="contact-locations" aria-labelledby="contact-locations-title">
          <h2 id="contact-locations-title">{{ text_store }}</h2>
          <div class="panel-group" id="accordion">
            {% for location in locations %}
              <div class="panel panel-default">
                <div class="panel-heading">
                  <h3 class="panel-title">
                    <a href="#collapse-location{{ location.location_id }}" class="accordion-toggle" data-toggle="collapse" data-parent="#accordion">
                      {{ location.name }}
                      <i class="fa fa-angle-down" aria-hidden="true"></i>
                    </a>
                  </h3>
                </div>
                <div class="panel-collapse collapse" id="collapse-location{{ location.location_id }}">
                  <div class="panel-body">
                    {% if location.image %}
                      <div class="contact-image">
                        <img src="{{ location.image }}" alt="{{ location.name }}" title="{{ location.name }}" />
                      </div>
                    {% endif %}

                    {% if location.comment %}
                      <p><strong>{{ text_comment }}</strong></p>
                      <div>{{ location.comment }}</div>
                    {% endif %}

                    <div class="contact-location-grid">
                      <div>
                        <strong>{{ location.name }}</strong><br />
                        {{ location.address }}
                        {% if location.geocode %}
                          <br />
                          <a href="https://maps.google.com/maps?q={{ location.geocode|url_encode }}&hl={{ geocode_hl }}&t=m&z=15" target="_blank" rel="noopener" class="btn btn-info">
                            <i class="fa fa-map-marker" aria-hidden="true"></i>
                            {{ button_map }}
                          </a>
                        {% endif %}
                      </div>
                      <div>
                        {{ location.telephone }}
                        {% if location.fax %}<br />{{ text_fax }}: {{ location.fax }}{% endif %}
                      </div>
                      {% if location.open %}<div>{{ location.open }}</div>{% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>

{% if basel_map_style %}
<script>
  $(document).ready(function() {
    new Maplace({
      locations: [
        {
          lat: {{ basel_map_lat }},
          lon: {{ basel_map_lon }}
        }
      ],
      controls_on_map: true,
      start: 1,
      map_options: {
        zoom: 15,
        scrollwheel: false
      }
    }).Load();

    {% if basel_map_lat and basel_map_lon and basel_map_style == "full_width" %}
      $('body').addClass('full-width-map');
    {% endif %}
  });
</script>
{% endif %}

{{ footer }}
