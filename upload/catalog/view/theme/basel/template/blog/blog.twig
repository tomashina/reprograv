{{ header }}

<div class="container blog-article-page">
  <nav aria-label="Putanja stranice">
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}
          <li><span aria-current="page">{{ breadcrumb.text }}</span></li>
        {% else %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>

  <div class="row">
    {{ column_left }}

    {% if column_left and column_right %}
      {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
      {% set class = 'col-sm-12' %}
    {% endif %}

    <main id="content" class="{{ class }}">
      {{ content_top }}

      <article class="blog blog_post article-shell">
        <header class="article-header">
          <span class="page-eyebrow">Repro-Grav savjeti</span>
          <h1 id="page-title">{{ heading_title }}</h1>

          {% if post_date_added_status or post_author_status or post_page_view_status %}
            <div class="article-meta" aria-label="Podaci o članku">
              {% if post_date_added_status %}
                <time datetime="{{ date_added_full }}">
                  <i class="fa fa-calendar-o" aria-hidden="true"></i>
                  {{ date_added_day }}. {{ date_added_month }}
                </time>
              {% endif %}
              {% if post_author_status %}
                <span>
                  <i class="fa fa-user-o" aria-hidden="true"></i>
                  {{ text_posted_by }}: {{ author }}
                </span>
              {% endif %}
              {% if post_page_view_status %}
                <span>
                  <i class="fa fa-eye" aria-hidden="true"></i>
                  {{ text_read }}: {{ count_read }}
                </span>
              {% endif %}
            </div>
          {% endif %}
        </header>

        {% if main_thumb and blogsetting_post_thumb %}
          <figure class="main_thumb">
            <img
              src="{{ main_thumb }}"
              alt="{{ heading_title }}"
              width="{{ img_width }}"
              height="{{ img_height }}"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        {% endif %}

        <div class="main_description article-content">
          {{ description }}
        </div>

        {% if tags %}
          <div class="post_tags" aria-label="Oznake članka">
            <span>{{ text_tags }}</span>
            <div>
              {% for tag in tags %}
                <a href="{{ tag.href }}">{{ tag.tag }}</a>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {% set share_label = 'Podijelite članak' %}
        {% set share_context = 'article' %}
        {% include 'basel/template/common/share_buttons.twig' %}

        {% if products %}
          <section class="article-related-section" aria-labelledby="related-products-title">
            <div class="article-section-heading">
              <span class="page-eyebrow">Istražite ponudu</span>
              <h2 id="related-products-title">{{ text_related_products }}</h2>
            </div>
            <div class="grid-holder grid product-card-grid grid{{ rel_prod_per_row }}">
              {% for product in products %}
                {% include 'basel/template/product/single_product.twig' %}
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% if related_blogs %}
          <section class="article-related-section" aria-labelledby="related-blog-title">
            <div class="article-section-heading">
              <span class="page-eyebrow">Nastavite čitati</span>
              <h2 id="related-blog-title">{{ text_related_blog }}</h2>
            </div>
            <div class="blog-related-grid">
              {% for blog in related_blogs %}
                <article class="blog-card blog-card-related">
                  {% if blog.image and rel_thumb_status %}
                    <a class="blog-card-media" href="{{ blog.href }}" aria-label="{{ blog.title }}">
                      <img src="{{ blog.image }}" alt="{{ blog.title }}" loading="lazy" decoding="async" />
                    </a>
                  {% endif %}
                  <div class="blog-card-body">
                    <h3 class="blog-title"><a href="{{ blog.href }}">{{ blog.title }}</a></h3>
                    <p class="short-description">{{ blog.short_description }}</p>
                    <a class="blog-card-link" href="{{ blog.href }}">
                      {{ text_read_more }}
                      <i class="fa fa-angle-right" aria-hidden="true"></i>
                    </a>
                  </div>
                </article>
              {% endfor %}
            </div>
          </section>
        {% endif %}
      </article>

      {{ content_bottom }}
    </main>

    {{ column_right }}
  </div>
</div>

<script type="application/ld+json">
{{ article_json }}
</script>

{{ footer }}
