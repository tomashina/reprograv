{{ header }}

<div class="container blog-index-page">
  <nav aria-label="Putanja stranice">
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}
          <li><span aria-current="page">{{ breadcrumb.text }}</span></li>
        {% else %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>

  <div class="row">
    {{ column_left }}

    {% if column_left and column_right %}
      {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
      {% set class = 'col-sm-12' %}
    {% endif %}

    <main id="content" class="{{ class }}">
      {{ content_top }}

      <div class="blog blog-index">
        <header class="blog-page-intro">
          <span class="page-eyebrow">Znanje iz prakse</span>
          <h1 id="page-title">{{ heading_title }}</h1>

          {% if description %}
            <div class="main_description">{{ description }}</div>
          {% endif %}
        </header>

        {% if blogs %}
          <div class="blog-editorial-list" role="list">
            {% for blog in blogs %}
              <article class="blog-editorial-item" role="listitem">
                {% if blog.image %}
                  <a class="blog-editorial-media" href="{{ blog.href }}" aria-label="{{ blog.title }}">
                    <img src="{{ blog.image }}" alt="{{ blog.title }}" loading="lazy" decoding="async" />
                  </a>
                {% endif %}

                <div class="blog-editorial-content">
                  <time class="blog-editorial-date" datetime="{{ blog.date_added_iso }}">
                    <i class="fa fa-calendar-o" aria-hidden="true"></i>
                    {{ blog.date_added_day }}. {{ blog.date_added_month }} {{ blog.date_added_year }}.
                  </time>

                  <h2 class="blog-title"><a href="{{ blog.href }}">{{ blog.title }}</a></h2>

                  {% if blog.short_description %}
                    <p class="short-description">{{ blog.short_description }}</p>
                  {% endif %}

                  <a class="btn btn-outline blog-editorial-button" href="{{ blog.href }}">
                    {{ text_read_more }}
                    <i class="fa fa-angle-right" aria-hidden="true"></i>
                  </a>
                </div>
              </article>
            {% endfor %}
          </div>

          {% if pagination %}
            <div class="row pagination-holder blog-pagination">
              <div class="col-sm-6 xs-text-center">
                {{ pagination|replace({'&gt;|': "&gt;&gt", "|&lt;" : "&lt;&lt"}) }}
              </div>
              <div class="col-sm-6 text-right xs-text-center">
                <span class="pagination-text">{{ results }}</span>
              </div>
            </div>
          {% endif %}
        {% else %}
          <div class="blog-empty-state">{{ text_no_blog_posts }}</div>
        {% endif %}
      </div>

      {{ content_bottom }}
    </main>

    {{ column_right }}
  </div>
</div>

{{ footer }}
