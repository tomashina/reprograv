{{ header }}
<div class="container">

    <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
            <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>

    {% if short_description %}

        <div class="row short-description">
            <div class="col-md-12 mb-3">
                {{ short_description }}
            </div>
        </div>

    {% endif %}

    <div class="row">



        {{ column_left }}

        {% if column_left and column_right %}
            {% set class = 'col-sm-6' %}
        {% elseif column_left or column_right %}
            {% set class = 'col-md-9 col-sm-8' %}
        {% else %}
            {% set class = 'col-sm-12' %}
        {% endif %}

        <div id="content" class="{{ class }}">


            {{ content_top }}
            <h1 id="page-title">{{ heading_title }}</h1>



            {% if categories and category_subs_status %}
                <h3 class="lined-title hidden-xs"><span>{{ text_refine }}</span></h3>
                <div class="grid-holder categories carousel grid-holder grid6 prod_module0 carousel mb-3">
                    {% for category in categories %}
                        <div class="item single-product">
                            <a href="{{ category.href }}"><img src="{{ category.thumb }}" alt="{{ category.name }}" title="{{ category.name }}" /></a>
                            <a href="{{ category.href }}">{{ category.name }}</a></div>
                    {% endfor %}
                </div>

                <script>
                    $('.grid-holder.prod_module0').slick({
                        prevArrow: false,
                        nextArrow: false,
                        {% if categories|length > 5 %}
                        dots:true,
                        {% else %}
                          dots:false,
                        {% endif %}
                        respondTo:'min',
                        rows:1,
                        slidesToShow:6,slidesToScroll:2,responsive:[{breakpoint:1280,settings:{slidesToShow:5,slidesToScroll:2}},{breakpoint:960,settings:{slidesToShow:4,slidesToScroll:2}},{breakpoint:600,settings:{slidesToShow:2,slidesToScroll:1}},
                        ]
                    });
                    $('.product-style2 .single-product .icon').attr('data-placement', 'top');
                    $(window).on('load', function() {
                        if ($.fn.tooltip) {
                            $('[data-toggle=\'tooltip\']').tooltip({container: 'body'});
                        }
                    });
                </script>


            {% endif %}

            {% if products %}
                <div id="product-view" class="grid">

                    <div class="table filter">

                        <div class="table-cell nowrap hidden-sm hidden-md hidden-lg"><a class="filter-trigger-btn"></a></div>


                        <div class="table-cell w100">
                            <a href="{{ compare }}" id="compare-total" class="hidden-xs">{{ text_compare }}</a>
                        </div>

                        <div class="table-cell nowrap text-right ">
                            <div class="sort-select">
                                <span class="hidden-xs">{{ text_sort }}</span>


                                <select id="input-sort" class="form-control input-sm inline" aria-label="{{ text_sort }}" title="{{ text_sort }}" onchange="location = this.value;">
                                    {% for sorts in sorts %}
                                        {% if sorts.value == '%s-%s'|format(sort, order) %}
                                            <option value="{{ sorts.href }}" selected="selected"> {{ sorts.text }}</option>
                                        {% else %}
                                            <option value="{{ sorts.href }}" >{{ sorts.text }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="table-cell mobile-view-switch hidden-sm hidden-md hidden-lg" role="group" aria-label="{{ text_mobile_grid_label }}">
                            <button type="button" class="mobile-view-option" data-mobile-columns="1" aria-label="{{ text_mobile_one_column }}" title="{{ text_mobile_one_column }}" aria-pressed="false">
                                <span class="mobile-grid-icon mobile-grid-icon-one" aria-hidden="true"></span>
                            </button>
                            <button type="button" class="mobile-view-option" data-mobile-columns="2" aria-label="{{ text_mobile_two_columns }}" title="{{ text_mobile_two_columns }}" aria-pressed="true">
                                <span class="mobile-grid-icon mobile-grid-icon-two" aria-hidden="true"></span>
                            </button>
                        </div>

                    </div>

                    {% if not column_left and not column_right %}
                        {% set category_product_grid = 4 %}
                    {% else %}
                        {% set category_product_grid = basel_prod_grid %}
                    {% endif %}
                    <div class="grid-holder product-holder category-product-holder grid{{ category_product_grid }}">
                        {% for product in products %}
                            {% include 'basel/template/product/single_product.twig' %}
                        {% endfor %}
                    </div>
                </div> <!-- #product-view ends -->

                <div class="row pagination-holder">
                    <div class="col-sm-6 xs-text-center pagination-navigation">{{ pagination }}</div>
                    <div class="col-sm-6 text-right xs-text-center"><span class="pagination-text">{{ results }}</span></div>
                </div>

                <script>
                    (function($) {
                        var storageKey = 'rg_category_mobile_columns';

                        function getSavedColumns() {
                            try {
                                return window.localStorage.getItem(storageKey) === '1' ? 1 : 2;
                            } catch (error) {
                                return 2;
                            }
                        }

                        function applyMobileColumns(columns) {
                            var value = columns === 1 ? 1 : 2;
                            var $productView = $('#product-view');

                            $productView
                                .toggleClass('mobile-grid-columns-1', value === 1)
                                .toggleClass('mobile-grid-columns-2', value === 2);

                            $productView.find('[data-mobile-columns]').each(function() {
                                var isActive = Number($(this).data('mobile-columns')) === value;
                                $(this).toggleClass('active', isActive).attr('aria-pressed', isActive ? 'true' : 'false');
                            });
                        }

                        $(function() {
                            applyMobileColumns(getSavedColumns());
                        });

                        $(document)
                            .off('click.rgCategoryColumns', '[data-mobile-columns]')
                            .on('click.rgCategoryColumns', '[data-mobile-columns]', function() {
                                var columns = Number($(this).data('mobile-columns')) === 1 ? 1 : 2;

                                try {
                                    window.localStorage.setItem(storageKey, String(columns));
                                } catch (error) {
                                    // The preference remains active for the current page.
                                }

                                applyMobileColumns(columns);
                            })
                            .off('ajaxComplete.rgCategoryColumns')
                            .on('ajaxComplete.rgCategoryColumns', function() {
                                applyMobileColumns(getSavedColumns());
                            });
                    })(jQuery);
                </script>

            {% endif %}

            {% if not products %}
                <p>{{ text_empty }}</p>
            {% endif %}




            {{ content_bottom }}</div>


        {{ column_right }}</div>

</div>

{% if description %}

    <div class="container-fluid catdesc">
        <div class="container">
            <div class="row short-description">
                <div class="col-md-12 mb-5">
                    {{ description }}
                </div>
            </div>
        </div>

    </div>
{% endif %}

{% if category_faqs %}
    <section class="container category-faq-section" aria-labelledby="category-faq-title">
        <h2 id="category-faq-title">{{ text_category_faq }}</h2>
        <div class="category-faq-list">
            {% for faq in category_faqs %}
                <details class="category-faq-item">
                    <summary>{{ faq.question }}</summary>
                    <div class="category-faq-answer">{{ faq.answer }}</div>
                </details>
            {% endfor %}
        </div>
    </section>
{% endif %}

{% if category_faq_json %}
<script type="application/ld+json">
{{ category_faq_json }}
</script>
{% endif %}
{{ footer }}
