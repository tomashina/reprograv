{% macro category_navigation_items(items, level) %}
    <ul class="category-sibling-list category-tree-list category-tree-level-{{ level }}">
        {% for navigation_category in items %}
            <li class="category-tree-item{{ navigation_category.children ? ' has-children' : '' }}{{ navigation_category.expanded ? ' is-expanded' : '' }}">
                <div class="category-tree-row{{ navigation_category.current ? ' is-current' : '' }}">
                    <a href="{{ navigation_category.href }}" class="category-tree-link"{{ navigation_category.current ? ' aria-current="page"' : '' }}>
                        <span>{{ navigation_category.name }}</span>
                    </a>
                    {% if navigation_category.children %}
                        <button
                            type="button"
                            class="category-tree-toggle"
                            data-category-tree-toggle
                            aria-expanded="{{ navigation_category.expanded ? 'true' : 'false' }}"
                            aria-controls="category-tree-children-{{ navigation_category.category_id }}"
                            aria-label="{{ navigation_category.name }}"
                        >
                            <i class="fa fa-angle-right" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                    <span class="category-sibling-total">{{ navigation_category.total }}</span>
                </div>
                {% if navigation_category.children %}
                    <div id="category-tree-children-{{ navigation_category.category_id }}" class="category-tree-children"{{ not navigation_category.expanded ? ' hidden' : '' }}>
                        {{ _self.category_navigation_items(navigation_category.children, level + 1) }}
                    </div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{{ header }}
<div class="container category-catalogue-page">

    <nav aria-label="{{ text_breadcrumb_label }}">
        <ul class="breadcrumb">
            {% for breadcrumb in breadcrumbs %}
                {% if loop.last %}
                    <li><span aria-current="page">{{ breadcrumb.text }}</span></li>
                {% else %}
                    <li>
                        <a href="{{ breadcrumb.href }}"{% if loop.first %} aria-label="{{ text_breadcrumb_home }}"{% endif %}>{{ breadcrumb.text }}</a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>

    {% if short_description %}

        <div class="row short-description">
            <div class="col-md-12 mb-3">
                {{ short_description }}
            </div>
        </div>

    {% endif %}

    {% set show_category_navigation = category_navigation %}

    <div class="row">



        {% if show_category_navigation %}
            <aside id="category-navigation" class="category-navigation-sidebar column col-sm-4 col-md-3{{ column_left ? ' category-sidebar-stack' : '' }}">
                {% if column_left %}
                    <div class="category-sidebar-tabs" role="tablist" aria-label="{{ text_category_navigation }}">
                        <button type="button" id="category-sidebar-tab-filters" class="category-sidebar-tab" role="tab" aria-selected="false" aria-controls="category-sidebar-panel-filters" tabindex="-1" data-category-sidebar-tab="filters">
                            <i class="fa fa-sliders" aria-hidden="true"></i>
                            <span>Filter</span>
                        </button>
                        <button type="button" id="category-sidebar-tab-categories" class="category-sidebar-tab is-active" role="tab" aria-selected="true" aria-controls="category-sidebar-panel-categories" data-category-sidebar-tab="categories">
                            <i class="fa fa-bars" aria-hidden="true"></i>
                            <span>{{ text_category_navigation }}</span>
                        </button>
                    </div>
                {% endif %}
                <div id="category-sidebar-panel-categories" class="category-sidebar-panel" role="{{ column_left ? 'tabpanel' : 'presentation' }}"{{ column_left ? ' aria-labelledby="category-sidebar-tab-categories"' : '' }} data-category-sidebar-panel="categories">
                    <nav class="category-sibling-filter category-tree-navigation" aria-labelledby="category-navigation-title">
                        <div class="category-sibling-filter-heading">
                            <h2 id="category-navigation-title">{{ text_category_navigation }}</h2>
                            <button type="button" class="category-mobile-drawer-close hidden-sm hidden-md hidden-lg" aria-label="{{ text_category_navigation }}" title="{{ text_category_navigation }}">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        {{ _self.category_navigation_items(category_navigation, 0) }}
                    </nav>
                </div>
                {% if column_left %}
                    <div id="category-sidebar-panel-filters" class="category-filter-column category-sidebar-panel" role="tabpanel" aria-labelledby="category-sidebar-tab-filters" data-category-sidebar-panel="filters" hidden>
                        {{ column_left }}
                    </div>
                {% endif %}
            </aside>
        {% else %}
            {{ column_left }}
        {% endif %}

        {% if column_left and column_right %}
            {% set class = 'col-sm-6' %}
        {% elseif column_left or column_right or show_category_navigation %}
            {% set class = 'col-md-9 col-sm-8' %}
        {% else %}
            {% set class = 'col-sm-12' %}
        {% endif %}

        <div id="content" class="{{ class }}">


            {{ content_top }}
            <h1 id="page-title">{{ heading_title }}</h1>



            {% if categories and category_subs_status %}
                <h2 class="lined-title category-refine-title hidden-xs"><span>{{ text_refine }}</span></h2>
                <div class="grid-holder categories carousel grid-holder grid6 prod_module0 carousel mb-3">
                    {% for category in categories %}
                        <div class="item single-product">
                            <a class="category-refine-card" href="{{ category.href }}">
                                <span class="category-refine-media"><img src="{{ category.thumb }}" alt="" aria-hidden="true" /></span>
                                <span class="category-refine-name">{{ category.name }}<i class="fa fa-angle-right" aria-hidden="true"></i></span>
                            </a>
                        </div>
                    {% endfor %}
                </div>

                <script>
                    $('.grid-holder.prod_module0').slick({
                        prevArrow: false,
                        nextArrow: false,
                        {% if categories|length > 5 %}
                        dots:true,
                        {% else %}
                          dots:false,
                        {% endif %}
                        respondTo:'min',
                        rows:1,
                        slidesToShow:6,slidesToScroll:2,responsive:[{breakpoint:1280,settings:{slidesToShow:5,slidesToScroll:2}},{breakpoint:960,settings:{slidesToShow:4,slidesToScroll:2}},{breakpoint:600,settings:{slidesToShow:2,slidesToScroll:1{% if categories|length > 2 %},dots:true{% endif %}}},
                        ]
                    });
                    $('.product-style2 .single-product .icon').attr('data-placement', 'top');
                    $(window).on('load', function() {
                        if ($.fn.tooltip) {
                            $('[data-toggle=\'tooltip\']').tooltip({container: 'body'});
                        }
                    });
                </script>


            {% endif %}

            {% if products %}
                <div id="product-view" class="grid">

                    <div class="table filter category-toolbar">

                        <div class="table-cell nowrap hidden-sm hidden-md hidden-lg">
                            <button type="button" class="filter-trigger-btn"></button>
                        </div>


                        <div class="table-cell w100">
                            <a href="{{ compare }}" id="compare-total" class="hidden-xs">{{ text_compare }}</a>
                        </div>

                        <div class="table-cell nowrap text-right ">
                            <div class="sort-select">
                                <span class="hidden-xs">{{ text_sort }}</span>


                                <select id="input-sort" class="form-control input-sm inline" aria-label="{{ text_sort }}" title="{{ text_sort }}" onchange="location = this.value;">
                                    {% for sorts in sorts %}
                                        {% if sorts.value == '%s-%s'|format(sort, order) %}
                                            <option value="{{ sorts.href }}" selected="selected"> {{ sorts.text }}</option>
                                        {% else %}
                                            <option value="{{ sorts.href }}" >{{ sorts.text }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="table-cell mobile-view-switch hidden-sm hidden-md hidden-lg" role="group" aria-label="{{ text_mobile_grid_label }}">
                            <button type="button" class="mobile-view-option" data-mobile-columns="1" aria-label="{{ text_mobile_one_column }}" title="{{ text_mobile_one_column }}" aria-pressed="false">
                                <span class="mobile-grid-icon mobile-grid-icon-one" aria-hidden="true"></span>
                            </button>
                            <button type="button" class="mobile-view-option" data-mobile-columns="2" aria-label="{{ text_mobile_two_columns }}" title="{{ text_mobile_two_columns }}" aria-pressed="true">
                                <span class="mobile-grid-icon mobile-grid-icon-two" aria-hidden="true"></span>
                            </button>
                        </div>

                    </div>

                    {% if not column_left and not column_right and not show_category_navigation %}
                        {% set category_product_grid = 4 %}
                    {% else %}
                        {% set category_product_grid = basel_prod_grid %}
                    {% endif %}
                    <div class="grid-holder product-holder category-product-holder product-card-grid grid{{ category_product_grid }}">
                        {% for product in products %}
                            {% include 'basel/template/product/single_product.twig' %}
                        {% endfor %}
                    </div>
                </div> <!-- #product-view ends -->

                <div class="row pagination-holder">
                    <div class="col-sm-6 xs-text-center pagination-navigation">{{ pagination }}</div>
                    <div class="col-sm-6 text-right xs-text-center"><span class="pagination-text">{{ results }}</span></div>
                </div>

                <script>
                    (function($) {
                        var storageKey = 'rg_category_mobile_columns';

                        function getSavedColumns() {
                            try {
                                return window.localStorage.getItem(storageKey) === '1' ? 1 : 2;
                            } catch (error) {
                                return 2;
                            }
                        }

                        function applyMobileColumns(columns) {
                            var value = columns === 1 ? 1 : 2;
                            var $productView = $('#product-view');

                            $productView
                                .toggleClass('mobile-grid-columns-1', value === 1)
                                .toggleClass('mobile-grid-columns-2', value === 2);

                            $productView.find('[data-mobile-columns]').each(function() {
                                var isActive = Number($(this).data('mobile-columns')) === value;
                                $(this).toggleClass('active', isActive).attr('aria-pressed', isActive ? 'true' : 'false');
                            });
                        }

                        $(function() {
                            applyMobileColumns(getSavedColumns());
                        });

                        $(document)
                            .off('click.rgCategoryColumns', '[data-mobile-columns]')
                            .on('click.rgCategoryColumns', '[data-mobile-columns]', function() {
                                var columns = Number($(this).data('mobile-columns')) === 1 ? 1 : 2;

                                try {
                                    window.localStorage.setItem(storageKey, String(columns));
                                } catch (error) {
                                    // The preference remains active for the current page.
                                }

                                applyMobileColumns(columns);
                            })
                            .off('ajaxComplete.rgCategoryColumns')
                            .on('ajaxComplete.rgCategoryColumns', function() {
                                applyMobileColumns(getSavedColumns());
                            });
                    })(jQuery);
                </script>

            {% endif %}

            {% if not products %}
                <p>{{ text_empty }}</p>
            {% endif %}




            {{ content_bottom }}</div>


        {{ column_right }}</div>

</div>

<script>
    (function($) {
        var mobileCategoryMedia = window.matchMedia('(max-width: 767px)');
        var $categoryDrawer = $('#category-navigation');
        var $categoryDrawerTrigger = $('.filter-trigger-btn');

        function activateCategorySidebarPanel(panelName, focusTab) {
            var $tabs = $categoryDrawer.find('[data-category-sidebar-tab]');
            var $panels = $categoryDrawer.find('[data-category-sidebar-panel]');
            var $activeTab = $tabs.filter('[data-category-sidebar-tab="' + panelName + '"]');
            var $activePanel = $panels.filter('[data-category-sidebar-panel="' + panelName + '"]');

            if (!$activeTab.length || !$activePanel.length) {
                return;
            }

            $tabs
                .removeClass('is-active')
                .attr({'aria-selected': 'false', 'tabindex': '-1'});
            $activeTab
                .addClass('is-active')
                .attr({'aria-selected': 'true', 'tabindex': '0'});
            $panels.prop('hidden', true);
            $activePanel.prop('hidden', false);

            if (focusTab) {
                $activeTab.focus();
            }
        }

        function closeCategoryDrawer(returnFocus) {
            $('html').removeClass('no-scroll side-filter-open');
            $('.body-cover').removeClass('active');
            $categoryDrawer.find('.tf-filter').attr('aria-hidden', 'true');
            $categoryDrawerTrigger.attr('aria-expanded', 'false');

            if (returnFocus && $categoryDrawerTrigger.length) {
                $categoryDrawerTrigger.focus();
            }
        }

        function prepareCategoryDrawer() {
            if (!$categoryDrawer.length || !mobileCategoryMedia.matches) {
                return;
            }

            if (!$categoryDrawerTrigger.hasClass('active')) {
                $categoryDrawerTrigger
                    .addClass('active')
                    .attr({
                        'aria-controls': 'category-navigation',
                        'aria-expanded': 'false'
                    })
                    .html('<i class="fa fa-sliders" aria-hidden="true"></i><span>{{ text_category_navigation }}</span>');
            }

            $categoryDrawerTrigger
                .off('click.rgCategoryDrawer')
                .on('click.rgCategoryDrawer', function(e) {
                    e.preventDefault();
                    $('html').addClass('no-scroll side-filter-open');
                    $('.body-cover').addClass('active');
                    $categoryDrawer.find('.tf-filter').attr('aria-hidden', 'false');
                    $categoryDrawerTrigger.attr('aria-expanded', 'true');
                });
        }

        $(document)
            .off('click.rgCategoryTree', '[data-category-tree-toggle]')
            .on('click.rgCategoryTree', '[data-category-tree-toggle]', function() {
                var $toggle = $(this);
                var isExpanded = $toggle.attr('aria-expanded') === 'true';
                var targetId = $toggle.attr('aria-controls');
                var $item = $toggle.closest('.category-tree-item');
                var $children = $('#' + targetId);

                $toggle.attr('aria-expanded', isExpanded ? 'false' : 'true');
                $item.toggleClass('is-expanded', !isExpanded);
                $children.prop('hidden', isExpanded);
            })
            .off('click.rgCategorySidebarTab', '[data-category-sidebar-tab]')
            .on('click.rgCategorySidebarTab', '[data-category-sidebar-tab]', function() {
                activateCategorySidebarPanel($(this).data('category-sidebar-tab'), false);
            })
            .off('keydown.rgCategorySidebarTab', '[data-category-sidebar-tab]')
            .on('keydown.rgCategorySidebarTab', '[data-category-sidebar-tab]', function(e) {
                if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') {
                    return;
                }

                e.preventDefault();
                activateCategorySidebarPanel($(this).data('category-sidebar-tab') === 'categories' ? 'filters' : 'categories', true);
            })
            .off('click.rgCategoryDrawerClose', '.category-mobile-drawer-close')
            .on('click.rgCategoryDrawerClose', '.category-mobile-drawer-close', function(e) {
                e.preventDefault();
                closeCategoryDrawer(true);
            });

        $(function() {
            prepareCategoryDrawer();
        });

        $(window)
            .off('resize.rgCategoryDrawer')
            .on('resize.rgCategoryDrawer', function() {
                if (!mobileCategoryMedia.matches) {
                    closeCategoryDrawer(false);
                } else {
                    prepareCategoryDrawer();
                }
            });
    })(jQuery);
</script>

{% if description %}

    <div class="container-fluid catdesc">
        <div class="container">
            <div class="row short-description">
                <div class="col-md-12 mb-0">
                    <div class="category-description-card">
                        {{ description }}
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endif %}

{% if category_faqs %}
    <section class="container category-faq-section" aria-labelledby="category-faq-title">
        <h2 id="category-faq-title">{{ text_category_faq }}</h2>
        <div class="category-faq-list">
            {% for faq in category_faqs %}
                <details class="category-faq-item">
                    <summary>{{ faq.question }}</summary>
                    <div class="category-faq-answer">{{ faq.answer }}</div>
                </details>
            {% endfor %}
        </div>
    </section>
{% endif %}

{% if category_faq_json %}
<script type="application/ld+json">
{{ category_faq_json }}
</script>
{% endif %}
{{ footer }}
