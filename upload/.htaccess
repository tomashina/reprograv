# .htaccess (OpenCart 3.x – standardni rewrite)
DirectoryIndex index.php
Options -Indexes
php_flag display_errors Off
<IfModule mod_rewrite.c>
RewriteEngine On
  RewriteBase /

  # Legacy product URLs whose slugs contained public prices. Absolute canonical
  # targets avoid a second redirect when an old non-HTTPS/non-www URL is used.
  RewriteRule ^6-4926-stari-rezervni-jastucic-jastuk-u-kutiji-rasprodaja-1eur/?$ https://www.repro-grav.com/6-4926-stari-rezervni-jastucic-jastuk-u-kutiji-rasprodaja [R=301,L,NE]
  RewriteRule ^gravometall-srebro-mesing-rasprodaja-30eur/?$ https://www.repro-grav.com/gravometall-srebro-mesing-rasprodaja [R=301,L,NE]
  RewriteRule ^m20-x-posebna-akcijska-cijena-6000-eur/?$ https://www.repro-grav.com/m20-x [R=301,L,NE]
  
  # One canonical host and protocol.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.repro-grav\.com$ [NC]
  RewriteRule ^ https://www.repro-grav.com%{REQUEST_URI} [L,R=301,NE]

  # Normalize the duplicate query-string homepage.
  RewriteCond %{THE_REQUEST} \s/+index\.php\?route=common/home(?:[&\s]) [NC]
  RewriteRule ^index\.php$ https://www.repro-grav.com/? [L,R=301]

  
RewriteRule ^sitemap-index.xml$ index.php?route=extension/feed/boost_sitemap [L]
RewriteRule ^googlebase.xml$ index.php?route=extension/feed/google_base [L]

RewriteRule ^kontaktirajte-nas index.php?route=information/contact [L]

RewriteRule ^system/storage/(.*) index.php?route=error/not_found [L]


RewriteRule ^product-category/pecatarstvo/pecati/?$ /pecatarstvo/pecati [R=301,L]

RewriteRule ^product-category/graverstvo/?$ /graviranje-materijali-strojevi-pribor-okviri [R=301,L]

RewriteRule ^product-category/graverstvo/materijali-za-graviranje/?$ /graverstvo/materijali-za-graviranje [R=301,L]

RewriteRule ^product-category/pecatarstvo/?$ /pecatarstvo [R=301,L]


RewriteRule ^laserski-strojevi-trotech /laserski-strojevi-trotec [R=301,L]


RewriteRule ^en/?$ /pecatarstvo-i-pribor [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^?]*) index.php?_route_=$1 [L,QSA]
</IfModule>

# Cache and compression for static assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:jpe?g|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:woff2?|eot|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php7_module>
   php_value default_charset "UTF-8"
   php_value memory_limit 512M
   php_value max_execution_time 36000
   php_value upload_max_filesize 999M
   php_value mysql.connect_timeout 20
   php_flag session.auto_start Off
   php_flag session.use_only_cookies On
   php_flag session.use_cookies On
   php_flag session.use_trans_sid Off
   php_value session.cookie_httponly "1"
   php_value session.gc_maxlifetime 3600
   php_flag display_errors Off
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value post_max_size 8M
   php_value session.save_path "/var/cpanel/php/sessions/ea-php74"
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_value default_charset "UTF-8"
   php_value memory_limit 512M
   php_value max_execution_time 36000
   php_value upload_max_filesize 999M
   php_value mysql.connect_timeout 20
   php_flag session.auto_start Off
   php_flag session.use_only_cookies On
   php_flag session.use_cookies On
   php_flag session.use_trans_sid Off
   php_value session.cookie_httponly "1"
   php_value session.gc_maxlifetime 3600
   php_flag display_errors Off
   php_value max_input_time 60
   php_value max_input_vars 1000
   php_value post_max_size 8M
   php_value session.save_path "/var/cpanel/php/sessions/ea-php74"
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
