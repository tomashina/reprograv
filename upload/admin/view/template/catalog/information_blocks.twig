        </div>

        <div class="row">
          <div class="col-md-4">
            <div class="form-group">
              <label class="col-sm-4 control-label">Raspored</label>
              <div class="col-sm-8">
                <select name="information_blocks[__BLOCK__][layout]" class="form-control">
                  <option value="image_right">Tekst lijevo / slika desno</option>
                  <option value="image_left">Slika lijevo / tekst desno</option>
                  <option value="full">Puna širina</option>
                </select>
              </div>
            </div>
