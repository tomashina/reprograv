<script type="text/template" id="information-block-action-template">
  <div class="well well-sm information-block-action-row" data-action-index="__ACTION__">
    <div class="row">
      <div class="col-md-2">
        <label>Vrsta</label>
        <select name="information_blocks[__BLOCK__][actions][__ACTION__][type]" class="form-control information-block-action-type">
          <option value="link">Gumb / poveznica</option>
          <option value="file">Datoteka</option>
        </select>
      </div>
      <div class="col-md-4">
        <label>URL</label>
        <input type="text" name="information_blocks[__BLOCK__][actions][__ACTION__][url]" value="" class="form-control" placeholder="https://... (i za vanjsku datoteku)" />
      </div>
      <div class="col-md-4">
        <label>Učitana datoteka</label>
        <div class="input-group">
          <input type="text" name="information_blocks[__BLOCK__][actions][__ACTION__][mask]" value="" class="form-control information-block-file-mask" placeholder="Nije učitana" readonly="readonly" />
          <input type="hidden" name="information_blocks[__BLOCK__][actions][__ACTION__][filename]" value="" class="information-block-file-name" />
          <span class="input-group-btn">
            <button type="button" class="btn btn-default btn-upload-information-block-file"><i class="fa fa-upload"></i></button>
          </span>
        </div>
      </div>
      <div class="col-md-1">
        <label>Novi tab</label>
        <div class="checkbox"><label><input type="checkbox" name="information_blocks[__BLOCK__][actions][__ACTION__][new_window]" value="1" /></label></div>
      </div>
      <div class="col-md-1 text-right">
        <label>&nbsp;</label>
        <button type="button" class="btn btn-danger btn-block btn-remove-information-block-action"><i class="fa fa-minus-circle"></i></button>
