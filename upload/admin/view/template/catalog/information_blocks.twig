            </div>
          </div>
        </div>

        <ul class="nav nav-tabs block-language-tabs" id="information-block-language-__BLOCK__">
          {% for language in languages %}
            <li{% if loop.first %} class="active"{% endif %}>
              <a href="#information-block-language-__BLOCK__-{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name|e }}" /> {{ language.name }}</a>
            </li>
          {% endfor %}
        </ul>

        <div class="tab-content">
          {% for language in languages %}
            <div class="tab-pane{% if loop.first %} active{% endif %}" id="information-block-language-__BLOCK__-{{ language.language_id }}">
              <div class="form-group">
                <label class="col-sm-2 control-label">Naslov</label>
                <div class="col-sm-10">
                  <input type="text" name="information_blocks[__BLOCK__][description][{{ language.language_id }}][title]" value="" class="form-control information-block-title" placeholder="Naslov bloka" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">ALT slike</label>
                <div class="col-sm-10">
                  <input type="text" name="information_blocks[__BLOCK__][description][{{ language.language_id }}][image_alt]" value="" class="form-control" placeholder="Opis slike za tražilice i čitače ekrana" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">Opis</label>
                <div class="col-sm-10">
                  <textarea name="information_blocks[__BLOCK__][description][{{ language.language_id }}][description]" class="form-control information-block-description" data-block-editor="1" rows="8"></textarea>
