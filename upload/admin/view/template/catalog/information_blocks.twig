<div class="tab-pane" id="tab-information-blocks">
  <input type="hidden" name="information_blocks_present" value="1" />

  {% if not information_blocks_installed %}
    <div class="alert alert-warning">
      <i class="fa fa-exclamation-triangle"></i>
      Tablice za sadržajne blokove još nisu instalirane. Prije spremanja importajte priloženi SQL.
    </div>
  {% endif %}

  <div class="alert alert-info">
    <i class="fa fa-info-circle"></i>
    Povucite blok za ručicu kako biste promijenili redoslijed. Slika može biti odabrana iz upravitelja slika ili unesena kao puni URL.
  </div>

  <div id="information-block-list">
    {% for block in information_blocks %}
      {% set block_row = loop.index0 %}
      <div class="panel panel-default information-block-row" data-block-index="{{ block_row }}">
        <div class="panel-heading information-block-heading">
          <span class="block-drag-handle" title="Povuci za sortiranje"><i class="fa fa-arrows-v"></i></span>
          <strong class="information-block-summary">
            {% set first_language = languages|first %}
            {{ (block.admin_title ?: block.description[first_language.language_id].title ?: 'Novi blok')|e }}
          </strong>
          <div class="pull-right">
            <button type="button" class="btn btn-xs btn-default btn-duplicate-information-block" title="Dupliciraj blok"><i class="fa fa-copy"></i> Dupliciraj</button>
            <button type="button" class="btn btn-xs btn-danger btn-remove-information-block" title="Obriši blok"><i class="fa fa-trash"></i></button>
            <button type="button" class="btn btn-xs btn-info" data-toggle="collapse" data-target="#information-block-body-{{ block_row }}" title="Otvori / zatvori"><i class="fa fa-chevron-down"></i></button>
          </div>
          <div class="clearfix"></div>
        </div>

        <div class="panel-collapse collapse" id="information-block-body-{{ block_row }}">
          <div class="panel-body">
            <input type="hidden" class="information-block-sort-order" name="information_blocks[{{ block_row }}][sort_order]" value="{{ block.sort_order }}" />

            <div class="form-group">
              <label class="col-sm-2 control-label">Naziv u adminu</label>
              <div class="col-sm-10">
                <input type="text" name="information_blocks[{{ block_row }}][admin_title]" value="{{ block.admin_title|e }}" class="form-control information-block-admin-title" placeholder="Interni naziv; ne prikazuje se na web stranici" />
                <p class="help-block">Služi samo za lakše prepoznavanje zatvorenog bloka u administraciji.</p>
              </div>
            </div>

            <div class="row">
              <div class="col-md-4">
                <div class="form-group">
                  <label class="col-sm-4 control-label">Raspored</label>
                  <div class="col-sm-8">
                    <select name="information_blocks[{{ block_row }}][layout]" class="form-control">
                      <option value="image_right"{% if block.layout == 'image_right' %} selected="selected"{% endif %}>Tekst lijevo / slika desno</option>
                      <option value="image_left"{% if block.layout == 'image_left' %} selected="selected"{% endif %}>Slika lijevo / tekst desno</option>
                      <option value="full"{% if block.layout == 'full' %} selected="selected"{% endif %}>Puna širina</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="col-md-4">
                <div class="form-group">
                  <label class="col-sm-4 control-label">Status</label>
                  <div class="col-sm-8">
                    <select name="information_blocks[{{ block_row }}][status]" class="form-control">
                      <option value="1"{% if block.status %} selected="selected"{% endif %}>Omogućeno</option>
                      <option value="0"{% if not block.status %} selected="selected"{% endif %}>Onemogućeno</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="col-sm-2 control-label">Slika</label>
              <div class="col-sm-10">
                <div class="information-block-image-field">
                  <a href="" id="thumb-information-block-{{ block_row }}" data-toggle="image" class="img-thumbnail">
                    <img src="{{ block.thumb|e }}" alt="" title="" data-placeholder="{{ information_block_placeholder|e }}" />
                  </a>
                  <input type="text" name="information_blocks[{{ block_row }}][image]" value="{{ block.image|e }}" id="input-information-block-{{ block_row }}" class="form-control information-block-image-input" placeholder="catalog/slika.jpg ili https://..." />
                </div>
              </div>
            </div>

            <ul class="nav nav-tabs block-language-tabs" id="information-block-language-{{ block_row }}">
              {% for language in languages %}
                <li{% if loop.first %} class="active"{% endif %}>
                  <a href="#information-block-language-{{ block_row }}-{{ language.language_id }}" data-toggle="tab">
                    <img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name|e }}" /> {{ language.name }}
                  </a>
                </li>
              {% endfor %}
            </ul>

            <div class="tab-content">
              {% for language in languages %}
                <div class="tab-pane{% if loop.first %} active{% endif %}" id="information-block-language-{{ block_row }}-{{ language.language_id }}">
                  <div class="form-group">
                    <label class="col-sm-2 control-label">Naslov</label>
                    <div class="col-sm-10">
                      <input type="text" name="information_blocks[{{ block_row }}][description][{{ language.language_id }}][title]" value="{{ block.description[language.language_id].title|e }}" class="form-control information-block-title" placeholder="Naslov bloka" />
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="col-sm-2 control-label">ALT slike</label>
                    <div class="col-sm-10">
                      <input type="text" name="information_blocks[{{ block_row }}][description][{{ language.language_id }}][image_alt]" value="{{ block.description[language.language_id].image_alt|e }}" class="form-control" placeholder="Opis slike za tražilice i čitače ekrana" />
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="col-sm-2 control-label">Opis</label>
                    <div class="col-sm-10">
                      <textarea name="information_blocks[{{ block_row }}][description][{{ language.language_id }}][description]" class="form-control information-block-description" data-block-editor="1" rows="8">{{ block.description[language.language_id].description|e }}</textarea>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>

            <hr />
            <div class="information-block-actions-heading">
              <h4><i class="fa fa-mouse-pointer"></i> Gumbi i datoteke</h4>
              <button type="button" class="btn btn-success btn-sm btn-add-information-block-action" data-block-index="{{ block_row }}"><i class="fa fa-plus"></i> Dodaj gumb / datoteku</button>
            </div>

            <div class="information-block-actions" data-block-index="{{ block_row }}">
              {% for action in block.actions %}
                {% set action_row = loop.index0 %}
                <div class="well well-sm information-block-action-row" data-action-index="{{ action_row }}">
                  <div class="row">
                    <div class="col-md-2">
                      <label>Vrsta</label>
                      <select name="information_blocks[{{ block_row }}][actions][{{ action_row }}][type]" class="form-control information-block-action-type">
                        <option value="link"{% if action.type == 'link' %} selected="selected"{% endif %}>Gumb / poveznica</option>
                        <option value="file"{% if action.type == 'file' %} selected="selected"{% endif %}>Datoteka</option>
                      </select>
                    </div>

                    <div class="col-md-4">
                      <label>URL</label>
                      <input type="text" name="information_blocks[{{ block_row }}][actions][{{ action_row }}][url]" value="{{ action.url|e }}" class="form-control" placeholder="https://... (i za vanjsku datoteku)" />
                    </div>

                    <div class="col-md-4">
                      <label>Učitana datoteka</label>
                      <div class="input-group">
                        <input type="text" name="information_blocks[{{ block_row }}][actions][{{ action_row }}][mask]" value="{{ action.mask|e }}" class="form-control information-block-file-mask" placeholder="Nije učitana" readonly="readonly" />
                        <input type="hidden" name="information_blocks[{{ block_row }}][actions][{{ action_row }}][filename]" value="{{ action.filename|e }}" class="information-block-file-name" />
                        <span class="input-group-btn">
                          <button type="button" class="btn btn-default btn-upload-information-block-file"><i class="fa fa-upload"></i></button>
                        </span>
                      </div>
                    </div>

                    <div class="col-md-1">
                      <label>Novi tab</label>
                      <div class="checkbox">
                        <label>
                          <input type="checkbox" name="information_blocks[{{ block_row }}][actions][{{ action_row }}][new_window]" value="1"{% if action.new_window %} checked="checked"{% endif %} />
                        </label>
                      </div>
                    </div>

                    <div class="col-md-1 text-right">
                      <label>&nbsp;</label>
                      <button type="button" class="btn btn-danger btn-block btn-remove-information-block-action"><i class="fa fa-minus-circle"></i></button>
                    </div>
                  </div>

                  <div class="row information-block-action-labels">
                    {% for language in languages %}
                      <div class="col-md-{{ languages|length > 3 ? 3 : 4 }}">
                        <label><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name|e }}" /> Tekst gumba</label>
                        <input type="text" name="information_blocks[{{ block_row }}][actions][{{ action_row }}][description][{{ language.language_id }}][label]" value="{{ action.description[language.language_id].label|e }}" class="form-control" placeholder="npr. Preuzmite katalog" />
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <button type="button" id="button-add-information-block" class="btn btn-primary" {% if not information_blocks_installed %}disabled="disabled"{% endif %}>
    <i class="fa fa-plus"></i> Dodaj sadržajni blok
  </button>
</div>

<script type="text/template" id="information-block-template">
