          <div class="col-md-4">
            <div class="form-group">
              <label class="col-sm-4 control-label">Status</label>
              <div class="col-sm-8">
                <select name="information_blocks[__BLOCK__][status]" class="form-control">
                  <option value="1" selected="selected">Omogućeno</option>
                  <option value="0">Onemogućeno</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">Slika</label>
          <div class="col-sm-10">
            <div class="information-block-image-field">
              <a href="" id="thumb-information-block-__BLOCK__" data-toggle="image" class="img-thumbnail">
