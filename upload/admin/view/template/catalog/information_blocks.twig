    </div>
    <div class="row information-block-action-labels">
      {% for language in languages %}
        <div class="col-md-{{ languages|length > 3 ? 3 : 4 }}">
          <label><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name|e }}" /> Tekst gumba</label>
          <input type="text" name="information_blocks[__BLOCK__][actions][__ACTION__][description][{{ language.language_id }}][label]" value="" class="form-control" placeholder="npr. Preuzmite katalog" />
        </div>
      {% endfor %}
    </div>
  </div>
</script>

<style>
  .information-block-heading { cursor: default; }
  .block-drag-handle { display:inline-block; margin-right:10px; padding:3px 6px; color:#777; cursor:move; }
  .information-block-row.ui-sortable-helper { box-shadow:0 8px 24px rgba(0,0,0,.18); }
  .information-block-placeholder { height:72px; border:2px dashed #1e91cf; background:#f4fbff; margin-bottom:15px; }
  .information-block-image-field { display:flex; gap:15px; align-items:flex-start; }
  .information-block-image-field .img-thumbnail { flex:0 0 162px; min-height:122px; display:flex; align-items:center; justify-content:center; }
  .information-block-image-field .img-thumbnail img { max-width:160px; max-height:120px; }
  .information-block-image-field .form-control { flex:1 1 auto; }
  .information-block-actions-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:15px; }
  .information-block-actions-heading h4 { margin:0; }
  .information-block-action-row { position:relative; }
  .information-block-action-labels { margin-top:12px; }
  .information-block-summary { vertical-align:middle; }
  @media (max-width:767px) {
    .information-block-image-field { display:block; }
    .information-block-image-field .form-control { margin-top:10px; }
    .information-block-actions-heading { display:block; }
    .information-block-actions-heading .btn { margin-top:10px; }
  }
</style>

<script>
(function($) {
  'use strict';

  var nextBlockIndex = {{ information_blocks|length }};
  var uploadUrl = 'index.php?route=tool/information_block_upload&user_token={{ user_token }}';

  function initialiseEditor($textarea) {
    if ($textarea.data('block-editor-ready')) {
      return;
    }

    $textarea.data('block-editor-ready', true).summernote({
      height: 220,
      disableDragAndDrop: true,
      emptyPara: '',
      toolbar: [
        ['style', ['style']],
        ['font', ['bold', 'italic', 'underline', 'clear']],
        ['para', ['ul', 'ol', 'paragraph']],
        ['insert', ['link']],
        ['view', ['codeview', 'fullscreen']]
      ]
    });
  }

  function initialiseBlock($block) {
    $block.find('textarea[data-block-editor="1"]').each(function() {
      initialiseEditor($(this));
    });

    $block.find('.block-language-tabs a:first').tab('show');
  }

  function updateSortOrders() {
    $('#information-block-list .information-block-row').each(function(index) {
      $(this).find('> .panel-collapse .information-block-sort-order').val(index * 10);
    });
  }

  function updateSummary($block) {
    var value = $.trim($block.find('.information-block-admin-title').val());

    if (!value) {
      value = $.trim($block.find('.information-block-title').first().val());
    }

    $block.find('> .information-block-heading .information-block-summary').text(value || 'Novi blok');
  }

  function addAction($block) {
    var blockIndex = $block.attr('data-block-index');
    var $actions = $block.find('.information-block-actions');
    var actionIndex = parseInt($actions.attr('data-next-action-index') || $actions.find('.information-block-action-row').length, 10);
    var template = $('#information-block-action-template').html()
      .replace(/__BLOCK__/g, blockIndex)
      .replace(/__ACTION__/g, actionIndex);

    $actions.append(template);
    $actions.attr('data-next-action-index', actionIndex + 1);

    return $actions.find('.information-block-action-row').last();
  }

  function addBlock() {
    var blockIndex = nextBlockIndex++;
    var template = $('#information-block-template').html().replace(/__BLOCK__/g, blockIndex);
    var $block = $(template);

    $('#information-block-list').append($block);
    initialiseBlock($block);
    updateSortOrders();

    return $block;
  }

  function renumberActions($block) {
    var blockIndex = $block.attr('data-block-index');

    $block.find('.information-block-action-row').each(function(actionIndex) {
      var $row = $(this);
      $row.attr('data-action-index', actionIndex);
      $row.find('[name]').each(function() {
        this.name = this.name.replace(/information_blocks\[\d+\]\[actions\]\[\d+\]/, 'information_blocks[' + blockIndex + '][actions][' + actionIndex + ']');
      });
    });

    $block.find('.information-block-actions').attr('data-next-action-index', $block.find('.information-block-action-row').length);
  }

  function duplicateBlock($source) {
    renumberActions($source);

    var sourceIndex = $source.attr('data-block-index');
    var values = [];

    $source.find('[name^="information_blocks["]').each(function() {
      var $field = $(this);
      var value = $field.val();

      if ($field.is('textarea[data-block-editor="1"]') && $field.data('block-editor-ready')) {
        value = $field.summernote('code');
      }

      values.push({
        name: this.name,
        value: value,
        checked: $field.is(':checkbox') ? $field.prop('checked') : null
      });
    });

    var $duplicate = addBlock();
    var duplicateIndex = $duplicate.attr('data-block-index');
    var actionCount = $source.find('.information-block-action-row').length;

    for (var actionIndex = 0; actionIndex < actionCount; actionIndex++) {
      addAction($duplicate);
    }

    values.forEach(function(field) {
      var targetName = field.name.replace('information_blocks[' + sourceIndex + ']', 'information_blocks[' + duplicateIndex + ']');
      var $target = $duplicate.find('[name]').filter(function() {
        return this.name === targetName;
      });

      if (!$target.length) {
        return;
      }

      if (field.checked !== null) {
        $target.prop('checked', field.checked);
      } else if ($target.is('textarea[data-block-editor="1"]')) {
        $target.summernote('code', field.value);
      } else {
        $target.val(field.value);
      }
    });

    $duplicate.find('.information-block-image-field img').attr('src', $source.find('.information-block-image-field img').attr('src'));
    updateSummary($duplicate);
    updateSortOrders();
  }

  function uploadFile($button) {
    var input = document.createElement('input');
    input.type = 'file';
    input.accept = '.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.jpg,.jpeg,.png,.webp';

    input.onchange = function() {
      var file = this.files && this.files[0];

      if (!file) {
        return;
      }

      var $row = $button.closest('.information-block-action-row');
      var formData = new FormData();
      formData.append('file', file);
      $button.prop('disabled', true).find('i').attr('class', 'fa fa-spinner fa-spin');

      fetch(uploadUrl, {
        method: 'POST',
        body: formData
      })
      .then(function(response) { return response.json(); })
      .then(function(json) {
        if (json.error) {
          window.alert(json.error);
          return;
        }

        $row.find('.information-block-file-name').val(json.filename || '');
        $row.find('.information-block-file-mask').val(json.mask || '');
        $row.find('.information-block-action-type').val('file');
      })
      .catch(function() {
        window.alert('Upload datoteke nije uspio.');
      })
      .then(function() {
        $button.prop('disabled', false).find('i').attr('class', 'fa fa-upload');
      });
    };

    input.click();
  }

  $(function() {
    $('#information-block-list .information-block-row').each(function() {
      var $block = $(this);
      var actionCount = $block.find('.information-block-action-row').length;
      $block.find('.information-block-actions').attr('data-next-action-index', actionCount);
      initialiseBlock($block);
      updateSummary($block);
    });

    $('#information-block-list').sortable({
      handle: '.block-drag-handle',
      placeholder: 'information-block-placeholder',
      forcePlaceholderSize: true,
      update: updateSortOrders
    });

    $('#button-add-information-block').on('click', function() {
      addBlock();
    });

    $('#information-block-list')
      .on('input', '.information-block-title, .information-block-admin-title', function() {
        updateSummary($(this).closest('.information-block-row'));
      })
      .on('change', '.information-block-image-input', function() {
        var value = $.trim($(this).val());
        var $image = $(this).siblings('a').find('img');

        if (/^https?:\/\//i.test(value)) {
          $image.attr('src', value);
        }
      })
      .on('click', '.btn-add-information-block-action', function() {
        addAction($(this).closest('.information-block-row'));
      })
      .on('click', '.btn-remove-information-block-action', function() {
        $(this).closest('.information-block-action-row').remove();
      })
      .on('click', '.btn-upload-information-block-file', function() {
        uploadFile($(this));
      })
      .on('click', '.btn-duplicate-information-block', function() {
        duplicateBlock($(this).closest('.information-block-row'));
      })
      .on('click', '.btn-remove-information-block', function() {
        if (window.confirm('Obrisati ovaj sadržajni blok?')) {
          $(this).closest('.information-block-row').remove();
          updateSortOrders();
        }
      });

    $('#form-information').on('submit', function() {
      $('#information-block-list textarea[data-block-editor="1"]').each(function() {
        var $textarea = $(this);

        if ($textarea.data('block-editor-ready')) {
          $textarea.val($textarea.summernote('code'));
        }
      });

      updateSortOrders();
    });

    updateSortOrders();
  });
})(jQuery);
</script>
