{{ header }}{{ column_left }}


<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-percent"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-category-special-bulk" class="form-horizontal">

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-categories">{{ entry_categories }}</label>
            <div class="col-sm-10">
              <select name="categories[]" id="input-categories" class="form-control" multiple size="12">
                {% for c in categories %}
                  <option value="{{ c.category_id }}">{{ c.name }}</option>
                {% endfor %}
              </select>
              <div class="checkbox" style="margin-top:8px">
                <label>
                  <input type="checkbox" name="include_sub" value="1" checked/> {{ entry_include_sub }}
                </label>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_discount_type }}</label>
            <div class="col-sm-10">
              <label class="radio-inline"><input type="radio" name="discount_type" value="percent" checked/> %</label>
              <label class="radio-inline"><input type="radio" name="discount_type" value="fixed"/> fiksni iznos</label>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-amount">{{ entry_amount }}</label>
            <div class="col-sm-10">
              <input type="text" name="amount" value="10" id="input-amount" class="form-control"/>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-customer-group">{{ entry_customer_group }}</label>
            <div class="col-sm-10">
              <select name="customer_group_id" id="input-customer-group" class="form-control">
                {% for cg in customer_groups %}
                  <option value="{{ cg.customer_group_id }}">{{ cg.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-priority">{{ entry_priority }}</label>
            <div class="col-sm-10">
              <input type="number" name="priority" value="0" id="input-priority" class="form-control"/>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-date-start">{{ entry_date_start }}</label>
            <div class="col-sm-4">
              <input type="date" name="date_start" value="{{ 'now'|date('Y-m-d') }}" id="input-date-start" class="form-control"/>
            </div>
            <label class="col-sm-2 control-label" for="input-date-end">{{ entry_date_end }}</label>
            <div class="col-sm-4">
              <input type="date" name="date_end" value="" id="input-date-end" class="form-control"/>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_apply_to }}</label>
            <div class="col-sm-10">
              <label class="checkbox-inline"><input type="checkbox" name="apply_product_specials" value="1" checked/> {{ entry_apply_product }}</label>
              <label class="checkbox-inline"><input type="checkbox" name="apply_ro_specials" value="1"/> {{ entry_apply_ro }}</label>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-overwrite">{{ entry_overwrite }}</label>
            <div class="col-sm-10">
              <input type="checkbox" name="overwrite" value="1" id="input-overwrite"/>
              <div class="checkbox" style="margin-top:8px">
                <label><input type="checkbox" name="dry_run" value="1"/> {{ entry_dry_run }}</label>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-round">{{ entry_round_rule }}</label>
            <div class="col-sm-10">
              <select name="round_rule" id="input-round" class="form-control">
                <option value="none">none</option>
                <option value="99">.99</option>
                <option value="95">.95</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <div class="col-sm-12 text-right">
              <button type="submit" name="action" value="apply" class="btn btn-success"><i class="fa fa-play"></i> {{ button_apply }}</button>
              <button type="submit" name="action" value="remove" class="btn btn-danger" onclick="return confirm('Remove specials for selected categories?');"><i class="fa fa-trash"></i> {{ button_remove }}</button>
              <button type="submit" name="action" value="report" class="btn btn-info"><i class="fa fa-list"></i> {{ button_report }}</button>
            </div>
          </div>

        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_report_header }}</h3>
      </div>
      <div class="panel-body">
        {% if report and report|length %}
        <table class="table table-bordered table-report">
          <thead>
            <tr>
              <th style="width:25%">{{ entry_categories }}</th>
              <th>Proizvodi i specials</th>
            </tr>
          </thead>
          <tbody>
            {% for cid, cat in report %}
            <tr>
              <td><strong>{{ cat.name }}</strong><br/>
                <span class="badge ps">PS: {{ cat.product_specials }}</span>
                <span class="badge ro">RO: {{ cat.ro_specials }}</span>
              </td>
              <td>
                {% for pid, p in cat.products %}
                  <div style="margin-bottom:10px">
                    <strong>#{{ pid }} — {{ p.name }}</strong>
                    {% if p.product_specials|length %}
                      <div style="margin-top:4px" class="badge ps">Product specials ({{ p.product_specials|length }})</div>
                      <ul style="margin:6px 0 10px 18px">
                        {% for s in p.product_specials %}
                          <li>
                            price: {{ s.price }}
                            {% if s.date_start %}| {{ s.date_start }}{% endif %}
                            {% if s.date_end %} → {{ s.date_end }}{% endif %}
                            <form method="post" class="inline-form" onsubmit="return confirm('Obrisati ovaj product special?')">
                              <input type="hidden" name="categories[]" value="{{ cid }}"/>
                              <input type="hidden" name="include_sub" value="1"/>
                              <input type="hidden" name="customer_group_id" value="{{ customer_groups[0].customer_group_id }}"/>
                              <input type="hidden" name="action" value="delete_ps"/>
                              <input type="hidden" name="ps_id" value="{{ s.product_special_id }}"/>
                              <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i> {{ button_delete }}</button>
                            </form>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}

                    {% if p.ro_specials|length %}
                      <div class="badge ro">RO specials ({{ p.ro_specials|length }})</div>
                      <ul style="margin:6px 0 10px 18px">
                        {% for s in p.ro_specials %}
                          <li>
                            price: {{ s.price }}
                            {% if s.date_start %}| {{ s.date_start }}{% endif %}
                            {% if s.date_end %} → {{ s.date_end }}{% endif %}
                            <form method="post" class="inline-form" onsubmit="return confirm('Obrisati ovaj RO special?')">
                              <input type="hidden" name="categories[]" value="{{ cid }}"/>
                              <input type="hidden" name="include_sub" value="1"/>
                              <input type="hidden" name="customer_group_id" value="{{ customer_groups[0].customer_group_id }}"/>
                              <input type="hidden" name="action" value="delete_ros"/>
                              <input type="hidden" name="ro_relatedoptions_id" value="{{ s.relatedoptions_id }}"/>
                              <button class="btn btn-xs btn-danger"><i class="fa fa-trash"></i> {{ button_delete }}</button>
                            </form>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                {% endfor %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
          <em>{{ text_no_report }}</em>
        {% endif %}
      </div>
    </div>

  </div>
</div>


{{ footer }}

