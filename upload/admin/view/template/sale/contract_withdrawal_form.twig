{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-contract-withdrawal" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-file-text-o"></i> {{ text_form }} — {{ withdrawal.reference }}</h3></div>
      <div class="panel-body">
        <div class="row">
          <div class="col-md-8">
            <table class="table table-bordered">
              <tr><th style="width:260px">{{ entry_reference }}</th><td>{{ withdrawal.reference }}</td></tr>
              <tr><th>{{ entry_submitted_at }}</th><td>{{ withdrawal.submitted_at }}</td></tr>
              <tr><th>{{ entry_customer }}</th><td>{{ withdrawal.full_name }}</td></tr>
              <tr><th>{{ entry_email }}</th><td><a href="mailto:{{ withdrawal.email }}">{{ withdrawal.email }}</a></td></tr>
              <tr><th>{{ entry_phone }}</th><td>{{ withdrawal.phone ?: '—' }}</td></tr>
              <tr><th>{{ entry_address }}</th><td>{{ withdrawal.address_line }}, {{ withdrawal.postal_code }} {{ withdrawal.city }}, {{ withdrawal.country_code }}</td></tr>
              <tr><th>{{ entry_order_number }}</th><td>{{ withdrawal.order_number }}{% if withdrawal.order_id %} (OpenCart #{{ withdrawal.order_id }}){% endif %}</td></tr>
              <tr><th>{{ entry_contract_date }}</th><td>{{ withdrawal.contract_date ?: '—' }}</td></tr>
              <tr><th>{{ entry_received_date }}</th><td>{{ withdrawal.received_date ?: '—' }}</td></tr>
              <tr><th>{{ entry_declaration }}</th><td>{{ withdrawal.declaration }}</td></tr>
              <tr><th>{{ entry_items }}</th><td style="white-space:pre-line">{{ withdrawal.items }}</td></tr>
              <tr><th>{{ entry_note }}</th><td style="white-space:pre-line">{{ withdrawal.note ?: '—' }}</td></tr>
              <tr><th>{{ entry_consumer_notified_at }}</th><td>{{ withdrawal.consumer_notified_at ?: '—' }}</td></tr>
              <tr><th>{{ entry_admin_notified_at }}</th><td>{{ withdrawal.admin_notified_at ?: '—' }}</td></tr>
              <tr><th>{{ entry_snapshot_hash }}</th><td><code>{{ withdrawal.snapshot_hash }}</code></td></tr>
            </table>
            {% if withdrawal.notification_error %}<div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_notification_warning }}<pre style="margin-top:10px">{{ withdrawal.notification_error }}</pre></div>{% endif %}
          </div>
          <div class="col-md-4">
            <form id="form-contract-withdrawal" action="{{ action }}" method="post" class="well">
              <div class="form-group">
                <label for="input-status">{{ entry_status }}</label>
                <select id="input-status" name="status" class="form-control">{% for key, label in statuses %}<option value="{{ key }}"{% if key == status %} selected{% endif %}>{{ label }}</option>{% endfor %}</select>
              </div>
              <div class="form-group">
                <label for="input-internal-note">{{ entry_internal_note }}</label>
                <textarea id="input-internal-note" name="internal_note" rows="10" maxlength="10000" class="form-control">{{ internal_note }}</textarea>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
